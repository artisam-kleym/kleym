{
  "name": "kleym",
  "private": true,
  "type": "module",
  "description": "Distribute Stellar assets with a link. No wallet address required.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "spike": "tsx scripts/spike-claim.ts",
    "diagnose": "tsx scripts/spike-diagnose.ts",
    "worker": "tsx src/workers/index.ts",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "verify:concurrency": "tsx scripts/verify-concurrency.ts",
    "verify:batches": "tsx scripts/verify-batches.ts",
    "verify:confirm": "tsx scripts/verify-confirm-worker.ts",
    "fixture:balance-id": "tsx scripts/make-balance-id-fixture.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.2.0",
    "clsx": "^2.1.1",
    "decimal.js": "^10.6.0",
    "ioredis": "^6.0.0",
    "next": "^16.3.1",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.1",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.26",
    "prisma": "^7.9.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "deepmerge-ts": ">=8.0.0"
    },
    "overridesReason": {
      "deepmerge-ts": "GHSA-ggr8-5vv4-36mx (high, stack exhaustion) via prisma > @prisma/config, which still pins 7.1.5. Remove when Prisma ships a fixed release. See README."
    }
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.6.4",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
