// Kleym data model — SPEC.md §4.
//
// INVARIANTS (SPEC.md §4.1). CI enforces the first two; uphold all four.
//
//   1. No column ever stores a seed, secret key, or mnemonic. Ephemeral seeds
//      live in the sender's browser and in the CSV they download, and nowhere
//      else. If a field name here suggests otherwise, the schema is wrong.
//   2. Money columns are Decimal(23,7) — Stellar's precision is exactly seven
//      decimal places. NEVER Float. Application code uses decimal.js or string
//      arithmetic, never JavaScript Number.
//   3. Campaign.csvExportedAt gates activation; a campaign cannot leave
//      CREATING until it is set.
//   4. ClaimLink.balanceId stays null until the owning Batch is CONFIRMED.
//
// This database is an INDEX AND CACHE over the ledger (SPEC.md §3.5). It is
// never the authority on whether money moved. Reconciliation resolves every
// disagreement in the chain's favour.

// Prisma 7's generator. The older `prisma-client-js` emits CJS only, so ESM
// named imports fail at runtime. SPEC.md §4 predates this; see README.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7 removed `url` from this block — the connection string now lives in
// prisma.config.ts for Migrate, and reaches PrismaClient through a driver
// adapter. SPEC.md §4 predates that change; see README for the deviation.
datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SENDER
}

/// A member's standing in an organisation. SPEC.md §1.3 (v2), issue #44.
///
/// Ordered by what each may do; `roleAtLeast` in lib/api/session-guard.ts
/// relies on this order. ADMIN on User is Kleym staff and is orthogonal.
enum OrgRole {
  VIEWER // read campaigns, links, history; no signing, no export
  OPERATOR // create campaigns, run the wizard, sign batches, reclaim
  APPROVER // Operator, plus approve a campaign for disbursement (#45)
  OWNER // everything, plus membership and settings
}

enum CampaignStatus {
  DRAFT // created, not yet funded on-chain
  CREATING // batches being signed/submitted
  ACTIVE // links live and claimable
  PARTIAL // some batches failed
  EXPIRED // past expiresAt, reclaim available
  RECLAIMED // all unclaimed funds returned
  CANCELLED
}

enum LinkStatus {
  PENDING // row exists, batch not yet confirmed
  ACTIVE // claimable balance live on ledger
  CLAIMED
  EXPIRED
  RECLAIMED
  FAILED // batch failed; no on-chain entry
}

/// Declared in DISPLAY order. Postgres sorts an enum by declaration order, so
/// `orderBy: { severity: 'asc' }` puts critical findings first because this
/// list says so — not because "error" happens to sort before "warn"
/// alphabetically, which is the accident the String column relied on.
enum FindingSeverity {
  error // critical: not auto-corrected, a person has to look
  warn // drift that was corrected, or a row that could not be read
  info
}

enum BatchStatus {
  PENDING
  SUBMITTED
  CONFIRMED
  FAILED
}

model User {
  id           String    @id @default(cuid())
  username     String    @unique
  passwordHash String // argon2id
  role         Role      @default(SENDER)
  isActive     Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  campaigns   Campaign[]
  sessions    Session[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
  invitations Invitation[] @relation("invitee")
  invited     Invitation[] @relation("inviter")
  memberships Membership[]
  approvals   CampaignApproval[]

  @@index([username])
}

/// The unit of ownership. Every Campaign, ApiKey and AuditLog row belongs to
/// one organisation, and every User is a member of at least one — the
/// migration gave every existing user a personal organisation, so a
/// single-user deployment behaves exactly as before.
model Organization {
  id        String   @id @default(cuid())
  name      String
  /// Dual control (#45). A campaign whose total value — amountPerLink ×
  /// linkCount, in its own asset — reaches `approvalThreshold` needs
  /// `approvalsRequired` approvals from Approvers other than its creator
  /// before a batch can be signed. Null threshold: dual control is off.
  approvalThreshold Decimal? @db.Decimal(23, 7)
  approvalsRequired Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  campaigns   Campaign[]
  apiKeys     ApiKey[]
  auditLogs   AuditLog[]
  invitations Invitation[]
}

enum ApprovalDecision {
  APPROVED
  REJECTED
}

/// One approver's decision on one campaign, bound to the TERMS it was given
/// for. `termsHash` covers (assetCode, assetIssuer, amountPerLink, linkCount,
/// expiresAt); a decision whose hash no longer matches the campaign counts
/// for nothing — the classic maker-checker bypass is approve small, then
/// edit large, and this is what closes it.
model CampaignApproval {
  id         String           @id @default(cuid())
  campaignId String
  approverId String
  decision   ApprovalDecision
  termsHash  String
  note       String?
  createdAt  DateTime         @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  approver User     @relation(fields: [approverId], references: [id])

  @@unique([campaignId, approverId])
  @@index([campaignId])
}

model Membership {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(OPERATOR)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

/// An admin-issued, single-use, time-bounded invitation. SPEC.md §5.4.
///
/// The admin never chooses or sees a password: the user sets their own at
/// /invite/[token], through the same argon2id path as a password change.
/// The token is stored as a SHA-256 hash exactly like Session.tokenHash —
/// the plaintext exists only in the URL the admin hands over, once.
model Invitation {
  id             String    @id @default(cuid())
  userId         String
  createdById    String
  /// The organisation the invitee joins, and as what. The membership is
  /// created with the invitation, so revoking the invitation removes both.
  organizationId String
  role           OrgRole   @default(OPERATOR)
  tokenHash      String    @unique // sha256 of the opaque URL token
  expiresAt   DateTime
  redeemedAt  DateTime?
  createdAt   DateTime  @default(now())

  user         User         @relation("invitee", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("inviter", fields: [createdById], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique // sha256 of the opaque cookie value
  /// Which of the user's organisations this session is acting in. Resolved
  /// against their memberships on EVERY request, so a removed membership
  /// ends access at once — the session merely remembers a preference.
  activeOrganizationId String?
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ApiKey {
  id             String    @id @default(cuid())
  userId         String // who issued it
  organizationId String // whose campaigns it reads
  name           String
  prefix     String    @unique // first 8 chars, shown in UI
  keyHash    String // argon2id of the full key
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([prefix])
}

model Campaign {
  id              String         @id @default(cuid())
  /// Who created it. Ownership is the ORGANISATION; this is provenance.
  userId          String
  organizationId  String
  /// The dual-control policy as it stood when this campaign was created
  /// (#45). The gate reads the STRICTER of this and the organisation's
  /// current policy, so loosening the policy affects only campaigns created
  /// afterwards — an Owner cannot switch the gate off, sign, and switch it
  /// back on for a campaign they made.
  approvalThreshold Decimal? @db.Decimal(23, 7)
  approvalsRequired Int      @default(1)
  /// The sponsor account (G…) bound to this campaign at creation (#48).
  /// Reserves return to the sponsoring account on merge, so a campaign stays
  /// with the sponsor that funded it for its whole life; failover in the
  /// pool applies to NEW campaigns only. Null only on rows older than the
  /// pool, which read as the primary sponsor.
  sponsorPublicKey String?
  name            String
  network         String // "testnet" | "public"
  senderPublicKey String // G... that funded it
  assetCode       String // "XLM" or e.g. "USDC"
  assetIssuer     String? // null for native
  amountPerLink   Decimal        @db.Decimal(23, 7)
  linkCount       Int
  expiresAt       DateTime
  status          CampaignStatus @default(DRAFT)
  csvExportedAt   DateTime? // hard gate: null blocks activation
  reserveEstimate Decimal?       @db.Decimal(23, 7)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user         User                    @relation(fields: [userId], references: [id])
  organization Organization            @relation(fields: [organizationId], references: [id])
  approvals    CampaignApproval[]
  links        ClaimLink[]
  batches      Batch[]
  reclaims     ReclaimBatch[]
  findings     ReconciliationFinding[]
  stranded     StrandedAccount[]

  @@index([userId, status])
  @@index([organizationId, status])
  @@index([expiresAt, status])
}

/// One submitted reclaim transaction. SPEC.md §3.4.
///
/// Membership is NOT planned in advance the way creation batches are. Which
/// balances are reclaimable is a question only the ledger can answer, and the
/// answer changes while the sender is signing, so each reclaim is built from a
/// live Horizon query and recorded here once it is on its way.
model ReclaimBatch {
  id              String   @id @default(cuid())
  campaignId      String
  transactionHash String   @unique
  balanceCount    Int
  /// Summed from the LEDGER's amounts, not from amountPerLink.
  amount          Decimal  @db.Decimal(23, 7)
  submittedAt     DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Batch {
  id              String      @id @default(cuid())
  campaignId      String
  sequence        Int // 1-based batch index
  transactionHash String?     @unique
  status          BatchStatus @default(PENDING)
  errorCode       String?
  submittedAt     DateTime?
  confirmedAt     DateTime?
  createdAt       DateTime    @default(now())

  campaign Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  links    ClaimLink[]

  @@unique([campaignId, sequence])
}

model ClaimLink {
  id         String  @id @default(cuid())
  campaignId String
  batchId    String?

  /// Ephemeral PUBLIC key (G...). The private half NEVER touches this system —
  /// it exists only in the sender's browser and the CSV they download.
  ephemeralPublicKey String @unique

  balanceId String?    @unique // set once the batch confirms
  status    LinkStatus @default(PENDING)
  label     String? // sender's own note: handle, email, etc.

  claimedBy   String? // recipient G...
  claimedAt   DateTime?
  claimTxHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  batch    Batch?    @relation(fields: [batchId], references: [id])
  delivery Delivery?
  findings ReconciliationFinding[]
  stranded StrandedAccount?

  @@index([campaignId, status])
  @@index([balanceId])
}

/// Where a link was emailed. The address is the only recipient PII Kleym
/// holds, belongs to someone who is not a Kleym user, and has a lifecycle
/// (#50): it is REDACTED — nulled, with `redactedAt` set — by the retention
/// sweep once the campaign has settled, or on an erasure request. What
/// survives redaction is the claim that a delivery happened (`sentAt`,
/// `openedAt`); the money's record lives on ClaimLink and is untouched.
model Delivery {
  id          String    @id @default(cuid())
  linkId      String    @unique
  email       String? // null once redacted
  redactedAt  DateTime?
  sentAt      DateTime?
  openedAt    DateTime?
  otpHash     String? // argon2id, 6-digit
  otpExpires  DateTime?
  otpAttempts Int       @default(0)
  createdAt   DateTime  @default(now())

  link ClaimLink @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([email])
}

/// A disagreement between the database and the ledger, as reconciliation found it.
///
/// Persisted rather than only logged, because SPEC.md §7.2 requires
/// /admin/reconciliation to SURFACE drift — a log line scrolls away, and the
/// CRITICAL class is explicitly not auto-corrected, so someone has to be able
/// to find it later and act on it.
///
/// Keyed on (linkId, kind) so a re-run updates the finding rather than adding a
/// duplicate every five minutes. §10.13 asks that a second run produce no extra
/// noise, and an append-only table would produce nothing but.
/// A stranded ephemeral account. SPEC.md §3.3.2, §7.3.
///
/// TX1 landed and TX2 never followed, so an account exists on the ledger
/// holding sponsored reserve that Kleym CANNOT recover — the merge needs the
/// ephemeral key, which Kleym deliberately does not hold.
///
/// Deliberately NOT a ReconciliationFinding. Drift is a disagreement between
/// the database and the chain, and something is wrong when it appears. A
/// strand is neither: both sides are telling the truth, and it is a known,
/// documented cost of the non-custodial guarantee (§12). Filing it as drift
/// would dilute the one report whose rows are all supposed to mean something.
model StrandedAccount {
  linkId             String   @id
  campaignId         String
  ephemeralPublicKey String
  /// XLM this account locks, from the LIVE base reserve when it was measured.
  lockedReserve      Decimal  @db.Decimal(23, 7)
  /// A non-zero asset balance: a partially-applied claim, not an ordinary
  /// strand. Reported separately because it needs a human, not patience.
  critical           Boolean  @default(false)
  detail             String
  /// When the ledger says the ephemeral account was last touched — TX1's time
  /// for an abandoned claim. The age test uses this, not a database column.
  lastLedgerActivity DateTime
  firstSeenAt        DateTime @default(now())
  lastSeenAt         DateTime @updatedAt

  link     ClaimLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([critical])
  @@index([campaignId])
}

model ReconciliationFinding {
  id         String   @id @default(cuid())
  linkId     String
  campaignId String
  kind       String // "claimed_on_chain" | "reclaimed_on_chain" | "critical_still_on_ledger" | "unresolved"
  severity   FindingSeverity
  detail     String
  /// Set when the finding was acted on, or when a later run found it resolved.
  resolvedAt DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt

  link     ClaimLink @relation(fields: [linkId], references: [id], onDelete: Cascade)
  campaign Campaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([linkId, kind])
  @@index([severity, resolvedAt])
  @@index([campaignId])
}

/// Append-only and hash-chained (#49). Every row written through
/// `recordAudit` takes the next `seq` and carries `prevHash` (the previous
/// row's `rowHash`) and `rowHash = SHA-256(prevHash ‖ canonical(row))`, with
/// `canonVersion` naming the canonical form so an upgrade cannot orphan
/// history. A database trigger refuses UPDATE and DELETE on this table
/// except inside the retention job's own transaction, which records what it
/// removed in a checkpoint row that is itself chained.
model AuditLog {
  id             String   @id @default(cuid())
  /// Position in the chain. Null only for rows written outside `recordAudit`,
  /// which verification reports as insertions.
  seq            BigInt?  @unique
  prevHash       String?
  rowHash        String?
  canonVersion   Int      @default(1)
  userId         String?
  /// The organisation the action happened in. Null for actions with no
  /// organisation (an admin acting on a user, a security event on a route).
  organizationId String?
  action         String // "campaign.create", "link.reclaim", ...
  entityType String?
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime @default(now())

  user         User?         @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
}

/// The single head of the audit chain. Writers lock this row (`FOR UPDATE`)
/// so two concurrent `recordAudit` calls cannot both read the same
/// predecessor and fork the chain — no retry loop needed.
model AuditChainHead {
  id      Int    @id @default(1)
  seq     BigInt @default(0)
  rowHash String @default("")
}

/// Keyed on (userId, key), not on key alone.
///
/// Idempotency keys are chosen by the client, so two users presenting the same
/// value is ordinary, not adversarial. A global primary key makes one user's
/// row addressable by another's write — see lib/api/idempotency.ts.
model IdempotencyKey {
  key         String
  userId      String
  requestHash String
  response    Json?
  statusCode  Int?
  createdAt   DateTime @default(now())

  @@id([userId, key])
  @@index([createdAt])
}
