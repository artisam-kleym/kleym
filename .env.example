# Every key this application requires. Startup validates the whole set and exits
# with a readable list if any are missing (src/lib/config/env.ts).
#
# Copy to .env and fill in. .env is gitignored and must never be committed.

# ─── Core ───────────────────────────────────────────────
NODE_ENV=
APP_URL=
# Separate static homepage. Empty keeps the compatibility homepage on the app.
# Set after the landing service is qualified; the app root then opens login/dashboard.
MARKETING_SITE_URL=
# Optional public origins for the network selector; no Mainnet deployment yet.
TESTNET_APP_URL=
MAINNET_APP_URL=
# Optional public project ID from dashboard.walletconnect.com. Enable after
# allowlisting the deployed HTTPS origin. Not a wallet seed or an API secret.
WALLETCONNECT_PROJECT_ID=

# ─── Database ───────────────────────────────────────────
DATABASE_URL=

# ─── Redis ──────────────────────────────────────────────
REDIS_URL=

# ─── Proxy ──────────────────────────────────────────────
# Number of trusted proxies in front of the app, used to pick the real client
# IP out of X-Forwarded-For. Railway terminates at one edge, so leave this
# UNSET unless the topology changes — a blank value is treated as 1.
# TRUSTED_PROXY_HOPS=1

# ─── Sessions ───────────────────────────────────────────
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
SESSION_TTL_HOURS=
# Ed25519 seed for signing audit exports (32 random bytes, base64). Same
# generator as SESSION_SECRET; a different value. Rotating it changes the
# public key on every later export — keep the old public key for old files.
AUDIT_SIGNING_SEED=

# Accounting export (#80): the anchor asset standing for each reporting currency,
# `USD=USDC:G…,EUR=EURC:G…`. Rates come from the DEX's trade history for that pair at
# each claim's ledger time. Default: Circle's USDC issuer for STELLAR_NETWORK.
# Test USDC prices are simulated and have no financial value.
# RATE_ANCHORS=USD=USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Credentials Kleym holds at rest (#46, #47) — TOTP shared keys and OIDC client
# secrets — are AES-256-GCM encrypted under this. 32 bytes, base64:
# `openssl rand -base64 32`. Rotating it invalidates every TOTP enrolment
# (users re-enrol) and every stored client secret (Owners re-enter it);
# passkeys and recovery codes are unaffected.
CREDENTIAL_ENCRYPTION_KEY=
# WebAuthn relying party; defaults to APP_URL's hostname.
WEBAUTHN_RP_ID=
WEBAUTHN_RP_NAME=Kleym

# ─── Stellar ────────────────────────────────────────────
STELLAR_NETWORK=
# Explicit rollout gates. Mainnet requires release approval/caps/owners; leave false.
# Set sponsored funding true only in a qualified environment before new USDC funding.
SPONSORED_FUNDING_ENABLED=false
MAINNET_DISTRIBUTION_ENABLED=false
HORIZON_URL=
NETWORK_PASSPHRASE=
# One deployment per network. Testnet passphrase: Test SDF Network ; September 2015
# Public passphrase: Public Global Stellar Network ; September 2015
# Never run automated fixtures against public. See docs/stellar-network.md.

# Sponsor account — pays recipient reserves and claim fees.
# Railway secret ONLY. Never in the database, never in git.
SPONSOR_PUBLIC_KEY=
SPONSOR_SECRET_KEY=
# Optional: more sponsor seeds, comma-separated, forming a pool with the
# primary. New campaigns go to the first sponsor with spendable XLM above
# SPONSOR_WORKING_THRESHOLD; a campaign stays with its sponsor for life.
SPONSOR_SECRET_KEYS_EXTRA=
SPONSOR_MIN_BALANCE_ALERT=
SPONSOR_WORKING_THRESHOLD=
# Optional: webhook that receives a JSON POST on sponsor alerts and failover
# (PagerDuty Events v2 and Slack incoming webhooks documented in docs/sponsor-runbook.md).
ALERT_WEBHOOK_URL=

# Compliance screening callback (#52). The URL is set per organisation in
# Settings; this optional secret signs each request (x-kleym-signature).
# The timeout is the whole budget for one call; past it the campaign is held.
SCREENING_WEBHOOK_SECRET=
SCREENING_TIMEOUT_MS=5000

# ─── Batching ───────────────────────────────────────────
MAX_OPS_PER_BATCH=
MAX_LINKS_PER_CAMPAIGN=
# Per-operation fee in stroops. Network minimum is 100; default 1000 leaves
# headroom for surge pricing. Leave unset unless a batch is being rejected
# with tx_insufficient_fee.
# BASE_FEE_STROOPS=1000

# ─── Email ──────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM=
# Historical Testnet development only. Production/public network always refuse bearer email.
LEGACY_BEARER_EMAIL_ENABLED=false

# ─── Seed (dev only) ────────────────────────────────────
SEED_ADMIN_USERNAME=
SEED_ADMIN_PASSWORD=
ALLOW_PROD_SEED=

# OpenTelemetry (#53). Set the endpoint to export traces and metrics over
# OTLP/HTTP; leave empty to export nothing. Headers (e.g. an auth token) are
# read by the exporter and redacted from logs.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_METRIC_EXPORT_INTERVAL_MS=15000
# Enable only after Lantern lists this deployment in its curated directory.
# Add a verified exact chrome-extension://<32-letter-id> for desktop embedding.
LANTERN_ORIGINS=
